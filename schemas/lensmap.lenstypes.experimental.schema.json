          {
            "not": {
              "anyOf": [
                {
                  "required": ["text"]
                },
                {
                  "required": ["reverse_text"]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "required": ["connection_types"],
  "additionalProperties": false,
  "title": "Lensmap experimental connection vocabulary",
