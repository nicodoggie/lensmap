{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "connection_types": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "extends": {
            "type": "string",
            "pattern": "\\S"
          },
