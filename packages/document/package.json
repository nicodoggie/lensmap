{
  "name": "@lensmap/document",
  "license": "MIT",
  "description": "Experimental Lensmap document engine: YAML analysis, semantic graphs and revision-bound source edits",
  "version": "0.4.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodoggie/lensmap.git",
    "directory": "packages/document"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1/schema.d.ts",
      "default": "./dist/v1/schema.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    }
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
