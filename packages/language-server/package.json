{
  "name": "@lensmap/language-server",
  "license": "MIT",
  "description": "Experimental Lensmap language server with an authenticated loopback browser preview",
  "version": "0.2.0",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodoggie/lensmap.git",
    "directory": "packages/language-server"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "lensmap-lsp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && node build.ts",
    "prepack": "pnpm -w exec turbo run build --filter=@lensmap/language-server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lensmap/document": "workspace:*",
    "vscode-languageserver": "11.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
