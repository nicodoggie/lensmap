{
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "name": "@lensmap/astro-loader",
  "description": "Experimental portable Lensmap Astro content integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodoggie/lensmap.git",
    "directory": "packages/astro-loader"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@lensmap/document": "workspace:*",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "astro": "7.4.0",
    "@astrojs/mdx": "8.1.0"
  },
  "devDependencies": {
    "astro": "7.4.0",
    "@astrojs/mdx": "8.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@types/node": "24.19.2"
  },
  "peerDependenciesMeta": {
    "@astrojs/mdx": {
      "optional": true
    }
  }
}
