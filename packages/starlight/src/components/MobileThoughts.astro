---
import { Icon } from "@astrojs/starlight/components";
import LiveInspector from "./LiveInspector.astro";

interface Props {
  inspectorId?: string;
}
const { inspectorId = "default" } = Astro.props;
---

<details class="lensmap-mobile-thoughts" data-lensmap-thoughts>
  <summary>
    <span>Thoughts</span>
    <Icon name="right-caret" size="1rem" class="lensmap-thoughts-caret" />
  </summary>
  <div class="lensmap-thoughts-content"><LiveInspector inspectorId={inspectorId} /></div>
</details>

<style>
.lensmap-mobile-thoughts {
  margin-bottom: 1rem;
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 0.375rem;
  background: var(--sl-color-bg-sidebar);
  color: var(--sl-color-text);
}
summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  list-style: none;
  padding: 0.75rem 1rem;
  color: var(--sl-color-white);
  font-size: var(--sl-text-sm);
  font-weight: 500;
  cursor: pointer;
}
summary:hover {
  background: var(--sl-color-gray-6);
}
summary::marker {
  content: "";
}
summary::-webkit-details-marker {
  display: none;
}
.lensmap-thoughts-caret {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
:global([dir="rtl"]) .lensmap-thoughts-caret {
  transform: rotate(180deg);
}
.lensmap-mobile-thoughts[open] > summary .lensmap-thoughts-caret {
  transform: rotate(90deg);
}
summary:focus-visible {
  outline: 2px solid var(--sl-color-text-accent);
  outline-offset: 2px;
}
[open] > summary {
  border-bottom: 1px solid var(--sl-color-gray-5);
}
.lensmap-thoughts-content {
  padding: 0 1rem 1rem;
}
.lensmap-thoughts-content :global([data-lensmap-inspector-target]) {
  border: 0;
  margin: 0;
}
.lensmap-thoughts-content :global([data-live-inspector] > h2) {
  font-size: var(--sl-text-lg);
  font-weight: 600;
  line-height: var(--sl-line-height-headings);
}
</style>
