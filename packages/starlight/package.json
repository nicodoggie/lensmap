{
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "name": "@lensmap/starlight",
  "description": "Experimental portable Lensmap Starlight viewer and inspector composition",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodoggie/lensmap.git",
    "directory": "packages/starlight"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./viewer": {
      "types": "./dist/ViewerHost.d.ts",
      "default": "./dist/ViewerHost.js"
    },
    "./viewer.css": "./dist/ViewerHost.css"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@lensmap/astro-loader": "workspace:*",
    "@lensmap/document": "workspace:*",
    "d3-force": "3.0.1",
    "d3-polygon": "3.0.2",
    "react-markdown": "10.1.0"
  },
  "peerDependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/starlight": "0.42.6",
    "@lensmap/web": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
