version: v1
frontmatter:
  title: Synthetic map
  description: SERVER_DESCRIPTION_SENTINEL
connection_types:
  host_relation:
    stroke-width: 3
node_styles:
  highlight:
    color: "#fff1c2"
    background-color: "#243346"
    border: "3px dashed #d9a441"
    --lensmap-scale: 1.4
    --lensmap-icon: "★"
nodes:
  - id: start
    summary: Start
    full_text: |
      # Start

      First static thought body.

      Entry: {props.entry.data.title}
    connections:
      - type: host_relation
        id: short
        summary: Short thought
        classes: [highlight]
        style: |
          @media (width < 700px) { color: #b5e6d2; }
        full_text: |
          # Short thought

          All of this short thought is visible.
      - id: long
        summary: Long thought
        style: "color: #d9a441; --lensmap-scale: auto;"
        full_text: |
          # Long thought

          Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling. Synthetic long thought with natural page scrolling.

