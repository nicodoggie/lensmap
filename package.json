{
  "name": "lensmap",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm test:release && tsc -p scripts/tsconfig.json && turbo run test typecheck build",
    "test:release": "node --test scripts/npm-promote.test.ts scripts/npm-wait.test.ts",
    "pack:packages": "node scripts/npm-packages.ts",
    "test:packages": "node scripts/npm-packages.ts --test",
    "pack:zed": "node scripts/zed-release.ts",
    "test:zed-package": "node scripts/zed-release.ts --test",
    "test:e2e": "pnpm build && playwright test --config apps/web/playwright.config.ts",
    "schema:export": "pnpm --filter @lensmap/document build && node packages/document/dist/export-schema.js schemas/lensmap.experimental-v1.schema.json"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
