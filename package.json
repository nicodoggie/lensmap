{
  "name": "lensmap",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && turbo run test typecheck build",
    "test:e2e": "pnpm build && playwright test --config apps/web/playwright.config.ts"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
