---
import { DocumentSession } from "@lensmap/document";
import { layoutSemanticGraph } from "../../../web/src/embed";
import HeroMap from "../components/HeroMap";
import { siteDestination } from "../hero";
import source from "../maps/hero.lensmap?raw";
import "../styles/site.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const snapshot = new DocumentSession("site:hero.lensmap", source).snapshot();
if (!snapshot.valid || !snapshot.graph)
  throw new Error(`Invalid hero: ${JSON.stringify(snapshot.diagnostics)}`);
const graph = layoutSemanticGraph(snapshot.graph);
const navigation = graph.nodes.flatMap((node) =>
  node.destination
    ? [{ title: node.title, ...siteDestination(node.destination.url, base) }]
    : [],
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>Lensmap — Write thoughts. Explore connections.</title>
    <meta name="description" content="A text-first mind map for thoughts that branch, converge and circle back. Write Markdown-rich notes. Explore them through a spatial lens." />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <noscript><style>.hero-map { display: none !important; }</style></noscript>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={base}>◎ lensmap</a>
      <nav aria-label="Main navigation"><a href={`${base}docs/`}>Documentation</a><a class="header-github" href="https://github.com/nicodoggie/lensmap" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </header>
    <main>
      <section class="hero-fallback" aria-label="About Lensmap">
        <h1>{graph.nodes[0].title}</h1><p>{graph.nodes.find(node => node.id === "subtitle")?.title}</p>
        <p>A text-first mind map for ideas that branch, converge and circle back.</p>
        <nav aria-label="Explore Lensmap"><ul>{navigation.map(item => <li><a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>{item.title}</a></li>)}</ul></nav>
      </section>
      <section class="hero-map" aria-label="Explore the Lensmap homepage">
        <HeroMap graph={graph} base={base} client:only="react" />
        <p class="hero-instruction">Drag or use arrow keys to explore · select, then open · Enter activates links</p>
      </section>
    </main>
    <footer class="site-footer"><p>Thoughts aren't always trees.</p><p>Open source · Markdown-rich · <a href={`${base}docs/getting-started/`}>Start with one thought →</a></p></footer>
  </body>
</html>
