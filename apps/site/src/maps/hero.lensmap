version: v1
node_styles:
  wordmark:
    background-color: "#dfeacb"
    color: "#14261e"
    border: "2px solid #ecf4df"
    font-family: "Georgia, serif"
    font-size: "48px"
    font-weight: 500
    --lensmap-scale: 2.85
  satellite:
    background-color: "#233f3c"
    color: "#e8eee2"
    border: "1px solid #749b88"
    font-size: "24px"
    padding: "8px"
    --lensmap-scale: 2.4
  group:
    background-color: "#25423b"
    color: "#dfeacb"
    border: "1px solid #8ba591"
    font-family: "Georgia, serif"
    font-size: "22px"
    --lensmap-scale: 1.8
nodes:
  - id: lensmap
    summary: Lensmap
    classes: [wordmark]
    style: {--lensmap-x: 0, --lensmap-y: 0}
    connections:
      - id: subtitle
        summary: Write thoughts. Explore connections.
        style: |
          background-color: #c9b98c;
          color: #242921;
          border: 1px solid #ded0a4;
          font-family: Georgia, serif;
          font-size: 20px;
          --lensmap-scale: 2.0;
          --lensmap-x: -700;
          --lensmap-y: 260;
          @container (width < 700px) {
            --lensmap-x: 0;
            --lensmap-y: 550;
          }
        connections:
          - id: get-started
            summary: Get started
            type: external_link
            url: docs/getting-started/
            style: |
              --lensmap-x: -420;
              --lensmap-y: -400;
              @container (width < 700px) {
                --lensmap-x: -650;
                --lensmap-y: -900;
              }
            classes: [satellite]
          - id: examples
            summary: Examples
            type: map_link
            url: examples/index.lensmap
            style: |
              --lensmap-x: -380;
              --lensmap-y: 460;
              @container (width < 700px) {
                --lensmap-x: 650;
                --lensmap-y: -900;
              }
            classes: [satellite]
          - id: documentation
            summary: Documentation
            type: external_link
            url: docs/
            style: |
              --lensmap-x: -820;
              --lensmap-y: -120;
              @container (width < 700px) {
                --lensmap-x: 0;
                --lensmap-y: -550;
              }
            classes: [satellite]
      - id: links
        summary: Links
        style: |
          --lensmap-x: 520;
          --lensmap-y: -400;
          @container (width < 700px) {
            --lensmap-x: -650;
            --lensmap-y: 900;
          }
        classes: [group]
        connections:
          - id: github
            summary: GitHub
            type: external_link
            url: https://github.com/nicodoggie/lensmap
            style: |
              --lensmap-x: 840;
              --lensmap-y: -80;
              @container (width < 700px) {
                --lensmap-x: 650;
                --lensmap-y: 900;
              }
            classes: [satellite]
