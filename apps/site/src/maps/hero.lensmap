version: v1
node_styles:
  wordmark:
    background-color: "#dfeacb"
    color: "#14261e"
    border: "2px solid #ecf4df"
    font-family: "Georgia, serif"
    font-size: "48px"
    font-weight: 500
    --lensmap-scale: 2.85
  satellite:
    background-color: "#233f3c"
    color: "#e8eee2"
    border: "1px solid #749b88"
    font-size: "24px"
    padding: "8px"
    --lensmap-scale: 2.4
  group:
    background-color: "#25423b"
    color: "#dfeacb"
    border: "1px solid #8ba591"
    font-family: "Georgia, serif"
    font-size: "22px"
    --lensmap-scale: 1.8
nodes:
  - id: lensmap
    summary: Lensmap
    classes: [wordmark]
    position: {x: 0, y: 0}
    connections:
      - id: subtitle
        summary: Write thoughts. Explore connections.
        position: {x: -700, y: 260}
        style:
          background-color: "#c9b98c"
          color: "#242921"
          border: "1px solid #ded0a4"
          font-family: "Georgia, serif"
          font-size: "20px"
          --lensmap-scale: 2.0
        connections:
          - id: get-started
            summary: Get started
            type: external_link
            url: docs/getting-started/
            position: {x: -420, y: -400}
            classes: [satellite]
          - id: examples
            summary: Examples
            type: map_link
            url: examples/index.lensmap
            position: {x: -380, y: 460}
            classes: [satellite]
          - id: documentation
            summary: Documentation
            type: external_link
            url: docs/
            position: {x: -820, y: -120}
            classes: [satellite]
      - id: links
        summary: Links
        position: {x: 520, y: -400}
        classes: [group]
        connections:
          - id: github
            summary: GitHub
            type: external_link
            url: https://github.com/nicodoggie/lensmap
            position: {x: 840, y: -80}
            classes: [satellite]
